<Window x:Class="Desensitizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="AI Desensitizer" Icon="Assets/Desensitizer.ico" Height="800" Width="1280" MinHeight="720" MinWidth="1040"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI Variable Text" Foreground="#172033" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTouchDown="Window_PreviewTouchDown" PreviewStylusDown="Window_PreviewStylusDown"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop" Closing="Window_Closing">
    <Window.Resources>
        <x:Array x:Key="MappingDecisions" Type="{x:Type sys:String}"><sys:String>Review</sys:String><sys:String>Replace</sys:String><sys:String>Keep as-is</sys:String></x:Array>
        <Storyboard x:Key="LoadingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E5EAF1" BorderThickness="0,0,0,1">
            <Grid Margin="24,0" MaxWidth="1600"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="8" Background="#3157D5" Margin="0,0,11,0"><TextBlock Text="AI" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="AI Desensitizer" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Three local AI reviewers with coherent entity mapping" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="AutoDeepReviewHeader" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed">
                        <TextBlock Text="Automatic deep check" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="AutoDeepReviewToggle" Content="On" Style="{StaticResource SettingsToggleStyle}" Click="AutoDeepReview_Click" ToolTip="Continue to a second local detector and AI pass after each scan" AutomationProperties.Name="Automatic deep check"/>
                    </StackPanel>
                    <Button x:Name="AboutButton" Content="About" Click="About_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="HomeView" Grid.Row="1" Grid.RowSpan="2" Margin="24" MaxWidth="1600" Panel.ZIndex="5">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="2,0,2,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your projects" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Each project keeps one encrypted replacement map across all its documents." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Import project" Click="OpenProject_Click" Margin="0,0,8,0" Padding="16,10"/><Button Content="+  Create project" Click="NewProject_Click" Style="{StaticResource PrimaryButton}" Padding="18,10"/></StackPanel></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="18,17" BorderBrush="#E9EDF3" BorderThickness="0,0,0,1"><TextBlock Text="RECENT PROJECTS" FontSize="12" FontWeight="SemiBold" Foreground="#536176" VerticalAlignment="Center"/></Border>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ProjectsList" BorderThickness="0" Background="Transparent" Padding="12" MouseDoubleClick="ProjectsList_MouseDoubleClick" SelectionChanged="ProjectsList_SelectionChanged">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ProjectRow" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="8" Padding="16"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProjectRow" Property="Background" Value="#F8FAFD"/><Setter TargetName="ProjectRow" Property="BorderBrush" Value="#BFCBE0"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ProjectRow" Property="Background" Value="#EEF2FF"/><Setter TargetName="ProjectRow" Property="BorderBrush" Value="#9EAEF5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="8" Background="#E4E9FF"><TextBlock Text="D" Foreground="#3157D5" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding LastOpenedLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="Encrypted local project" Foreground="#5A6678" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="3" Content="⋮" Click="ProjectMenu_Click" Width="30" Height="30" Margin="12,0,0,0" Padding="0" BorderThickness="0" Background="Transparent" FontSize="18" FontWeight="Bold" ToolTip="Project actions" AutomationProperties.Name="Project actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Edit neutral label" Click="EditProjectLabel_Click"/><MenuItem Header="Delete project" Foreground="#B42318" FontWeight="SemiBold" Click="DeleteProject_Click"/></ContextMenu></Button.ContextMenu></Button></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ProjectsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"><Border Width="64" Height="64" CornerRadius="32" Background="#EEF2FF"><TextBlock Text="D" FontSize="24" FontWeight="Bold" Foreground="#3157D5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="No projects yet" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" Margin="0,16,0,0"/><TextBlock Text="Create a project above to keep one encrypted mapping consistent across all of its documents." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Padding="14" BorderBrush="#E9EDF3" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Select a project, then open it to manage files and mappings." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><Button x:Name="RenameProjectButton" Grid.Column="1" Content="Rename" Click="RenameProject_Click" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="OpenSelectedProjectButton" Grid.Column="2" Content="Open project" Click="OpenSelectedProject_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></Grid></Border>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="ProjectBanner" Grid.Row="1" Margin="24,16" MaxWidth="1600" Background="#EEF2FF" BorderBrush="#D9E1FF" BorderThickness="1" CornerRadius="8" Padding="16,12" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackButton" Content="←  All projects" Click="BackToProjects_Click" Foreground="#174EA6" Background="Transparent" BorderThickness="0" Padding="8,4" Visibility="Collapsed"/><Border Width="1" Height="28" Background="#CBD5EB" Margin="10,0,16,0"/><Border x:Name="ProjectDot" Width="9" Height="9" CornerRadius="5" Background="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ProjectLabel" Text="No project open" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ProjectPathLabel" Text="Create or open an encrypted project to start" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/></StackPanel><Border Background="#E1E8FF" CornerRadius="11" Height="28" Padding="9,0" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Multi-layer local scan" VerticalAlignment="Center" Foreground="#3157D5" FontWeight="SemiBold" FontSize="11"/></Border></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="White" CornerRadius="12" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="1  Add files" FontSize="12" Foreground="#536176"/></Border><TextBlock Text="›" FontSize="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/><Border Background="White" CornerRadius="12" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="2  Review mappings" FontSize="12" Foreground="#536176"/></Border><TextBlock Text="›" FontSize="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/><Border Background="White" CornerRadius="12" Padding="10,5"><TextBlock Text="3  Export safely" FontSize="12" Foreground="#536176"/></Border></StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="WorkspaceView" Grid.Row="2" Margin="24,0,24,16" MaxWidth="1600" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" AllowDrop="True" PreviewDragOver="ProjectFiles_DragOver" PreviewDrop="ProjectFiles_Drop" DragLeave="ProjectFiles_DragLeave">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="18,17,18,14" BorderBrush="#E9EDF3" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Project files" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="FileCountLabel" Text="0 documents" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button x:Name="AddFilesButton" Grid.Column="1" Content="+  Add files" Click="AddFiles_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Padding="13,8"/></Grid></Border>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="FilesList" SelectionChanged="FilesList_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="9" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="11"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F5F7FB"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEF2FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#C7D2FE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="34" CornerRadius="4" Background="#E8EDFA" VerticalAlignment="Top"><TextBlock Text="DOC" FontSize="8" FontWeight="Bold" Foreground="#3157D5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,6,0"><TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="⋮" Click="FileMenu_Click" Width="30" Height="30" Padding="0" BorderThickness="0" Background="Transparent" FontSize="18" FontWeight="Bold" ToolTip="File actions" AutomationProperties.Name="File actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Remove from project" Foreground="#B42318" FontWeight="SemiBold" Click="RemoveFileMenu_Click"/></ContextMenu></Button.ContextMenu></Button></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="FileEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="230"><Border Width="52" Height="52" CornerRadius="26" Background="#F0F3F8"><TextBlock Text="+" FontSize="26" Foreground="#7B8BA3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="No documents yet" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="Add or drop Word and text files here." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <Border x:Name="FileDropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="#F2F6FF" BorderBrush="#3157D5" BorderThickness="2" CornerRadius="8" Margin="8"><TextBlock Text="Drop Word or text files here" Foreground="#3157D5" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#E9EDF3" BorderThickness="0,1,0,0" Padding="14"><StackPanel><Button x:Name="ScanButton" Content="Scan selected document" Click="Scan_Click" HorizontalAlignment="Stretch" IsEnabled="False"/><Button x:Name="DeepCheckButton" Content="Run deep check now" Click="DeepCheck_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed" IsEnabled="False" ToolTip="Recheck overlapping document sections with the local AI detectors"/>
                        <StackPanel x:Name="NoticePanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="MarkupNoticeText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#8A4B08" AutomationProperties.Name="Tracked changes and comments notice"/>
                            <TextBlock x:Name="ResumeNoticeText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#5A6678" Margin="0,8,0,0"/>
                            <Button x:Name="ResumeCheckButton" Visibility="Collapsed" Content="Resume previous check" Click="ResumeCheck_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0" ToolTip="Continue the interrupted check without repeating the sections that already finished"/>
                        </StackPanel></StackPanel></Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="18,14" BorderBrush="#E9EDF3" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Mapping review" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Review uncertain findings first, then approve in batches." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReviewListsButton" Content="Review lists" Click="ReviewLists_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" ToolTip="View or change the labels kept as-is, this project's generic terms, and organizations hidden by them" AutomationProperties.Name="Review lists"/>
                                <Button x:Name="AddMappingButton" Content="+  Add mapping" Click="AddMapping_Click" IsEnabled="False" Padding="12,7"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Filter:" Foreground="#536176" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="ReplaceFilterButton" Tag="Replace" Content="✓  0 Replace" Click="MappingFilter_Click" Style="{StaticResource FilterChipStyle}" Margin="0,0,8,0" AutomationProperties.HelpText="Show findings currently set to Replace. Select again to show all findings."/>
                                <Button x:Name="KeepFilterButton" Tag="Keep" Content="Keep: 0" Click="MappingFilter_Click" Style="{StaticResource FilterChipStyle}" Margin="0,0,8,0" AutomationProperties.HelpText="Show findings deliberately kept unchanged. Select again to show all findings."/>
                                <Button x:Name="ReviewFilterButton" Tag="Review" Content="⚠  0 Review" Click="MappingFilter_Click" Style="{StaticResource FilterChipStyle}" Margin="0,0,8,0" AutomationProperties.HelpText="Show findings that still need a decision. This filter opens by default."/>
                                <Button x:Name="VerifyFilterButton" Tag="Verify" Content="◒  0 Verify" Click="MappingFilter_Click" Style="{StaticResource FilterChipStyle}" AutomationProperties.HelpText="Show uncalibrated AI findings, contextual conflicts and lower detector scores. Scores and reviewer agreement are not proven accuracy."/>
                            </WrapPanel>
                            <Border x:Name="BulkActionBar" Grid.Row="2" Grid.ColumnSpan="2" Background="#F7F9FC" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BulkScopeText" Text="0 filtered rows" Foreground="#536176" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BulkReplaceButton" Content="Replace filtered" Click="BulkReplace_Click" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0"/><Button x:Name="BulkKeepButton" Content="Keep filtered" Click="BulkKeep_Click" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0"/><Button x:Name="BulkRememberButton" Content="Keep and remember" Click="BulkRemember_Click" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" ToolTip="Keep these values and remember project, system and product labels in this project" AutomationProperties.Name="Keep filtered and remember labels"/><Button x:Name="BulkReviewButton" Content="Set to Review" Click="BulkReview_Click" Style="{StaticResource CompactButtonStyle}"/></StackPanel></Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" FrozenColumnCount="1" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#FBFCFE" SelectionUnit="FullRow" SelectionMode="Extended" SelectionChanged="MappingSelectionChanged" CurrentCellChanged="MappingsGrid_CurrentCellChanged">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.RowStyle>
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Background="#F7F9FC"><Expander.Header><StackPanel Orientation="Horizontal" Margin="8,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#34445C"/><TextBlock Text="{Binding ItemCount, StringFormat='  ({0})'}" Foreground="#5A6678"/></StackPanel></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="DECISION" Width="152" MinWidth="152">
                                    <DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="12,0"/></Style></DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="3,2"/></Style></DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DecisionButtonStyle}" Click="DecisionMenu_Click" ToolTip="Choose whether to replace this value, keep it unchanged, or review it later." AutomationProperties.Name="Mapping decision" AutomationProperties.HelpText="Press Enter or Space to open the decision menu.">
                                                <Button.Content><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Decision}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" FontSize="17" Margin="8,-2,0,0" VerticalAlignment="Center"/></Grid></Button.Content>
                                                <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Replace with token" Tag="Replace" Click="DecisionMenuItem_Click"/><MenuItem Header="Keep as-is" Tag="Keep as-is" Click="DecisionMenuItem_Click"/><MenuItem Header="Keep as-is and remember" Tag="Keep as-is|remember" Click="DecisionMenuItem_Click" ToolTip="Keep this value and remember the label in this project. Only project, system and product labels can be remembered."/><MenuItem Header="Review later" Tag="Review" Click="DecisionMenuItem_Click"/></ContextMenu></Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SENSITIVE VALUE" Binding="{Binding OriginalValue}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="14,0,16,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding OriginalValue}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTemplateColumn Header="CONFIDENCE" Width="112" MinWidth="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0"><TextBlock Text="{Binding ConfidenceLabel}" VerticalAlignment="Center"/><TextBlock Text="{Binding VerificationLabel}" VerticalAlignment="Center" Foreground="#A15C00" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="DETECTION" Width="128" MinWidth="128"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#F3F4F6" CornerRadius="9" Padding="7,3" Margin="8,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding DetectionHelp}"><TextBlock Text="{Binding DetectionLabel}" Foreground="#536176" FontSize="11" FontWeight="SemiBold" AutomationProperties.HelpText="{Binding DetectionHelp}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="REPLACEMENT" Binding="{Binding Token}" Width="136" MinWidth="136" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,0,10,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Token}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="MappingEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="310"><Border Width="52" Height="52" CornerRadius="26" Background="#F0F3F8"><TextBlock Text="✓" FontSize="22" Foreground="#7B8BA3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Mappings will appear here" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="Scan a document for identity details, or add company-specific terms yourself." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel x:Name="MappingFilterEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300"><TextBlock Text="No findings in this filter" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="Select the active filter again to show all findings." TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <Border x:Name="AnalysisOverlay" Background="#F7FFFFFF" Visibility="Collapsed" Panel.ZIndex="20">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="880" Margin="16,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="LOCAL DOCUMENT CHECK" Foreground="#536176" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2.55*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="AnalysisPreviousCard" Grid.Column="0" Background="#EBF8F0" BorderBrush="#96D8AE" BorderThickness="1" CornerRadius="9" Padding="10,9" MinHeight="80" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock Text="✓  DONE" Foreground="#176B42" FontSize="10" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="AnalysisPreviousName" Foreground="#176B42" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                    </Border>
                                    <Border x:Name="AnalysisCurrentCard" Grid.Column="2" Background="White" BorderBrush="#9CAFFA" BorderThickness="1" CornerRadius="12" Padding="15,12" MinHeight="130" VerticalAlignment="Center" Opacity="1">
                                        <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                                        <StackPanel VerticalAlignment="Center">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid Width="29" Height="29" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Ellipse Width="25" Height="25" Stroke="#E1E7F0" StrokeThickness="3"/>
                                                    <Path Width="29" Height="29" Stroke="#3157D5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14.5,3.5 A 11,11 0 0 1 25.5,14.5" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform><RotateTransform x:Name="LoadingRotate"/></Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <StackPanel Grid.Column="1"><TextBlock x:Name="AnalysisStepBadge" Text="STEP 1 OF 4" Foreground="#3157D5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AnalysisStepName" Text="Reading document" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="AnalysisStepDetail" Text="Preparing the local analysis." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ProgressBar x:Name="AnalysisProgressBar" Minimum="0" Maximum="4" Value="0" Height="6" VerticalAlignment="Center" Foreground="#3157D5" Background="#E1E7F0" AutomationProperties.Name="Workflow progress"/>
                                                <TextBlock x:Name="AnalysisProgressPercent" Grid.Column="1" Text="0%" Foreground="#3157D5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0" MinWidth="32" TextAlignment="Right" ToolTip="Approximate progress across the current workflow."/>
                                            </Grid>
                                            <ItemsControl x:Name="ReviewerRows" Visibility="Collapsed" Margin="0,10,0,0" Focusable="False" AutomationProperties.Name="Progress of each reviewer">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent,Mode=OneWay}" Height="5" VerticalAlignment="Center" Foreground="#3157D5" Background="#E1E7F0" Margin="8,0" AutomationProperties.Name="{Binding Title}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="12" Foreground="#5A6678" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="AnalysisTimeText" Text="Elapsed 0:00" Foreground="#5A6678" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Off"/>
                                            <TextBlock x:Name="EstimateText" Visibility="Collapsed" Text="" Foreground="#5A6678" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Off"/>
                                            <TextBlock x:Name="ModelLoadText" Visibility="Collapsed" Text="" Foreground="#8A4B08" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="AnalysisNextCard" Grid.Column="4" Background="#F4F7FB" BorderBrush="#DEE5EE" BorderThickness="1" CornerRadius="9" Padding="10,9" MinHeight="80" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock Text="›  UP NEXT" Foreground="#5A6678" FontSize="10" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="AnalysisNextName" Foreground="#536176" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="This stays on your computer." Foreground="#18794E" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,11,0,0"/>
                                <Button x:Name="StopAnalysisButton" Grid.Row="3" Content="Stop" Click="StopAnalysis_Click" HorizontalAlignment="Center" MinWidth="112" Margin="0,9,0,0" AutomationProperties.Name="Stop current analysis"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#E9EDF3" BorderThickness="0,1,0,0" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ExportHelpText" Text="Select a document to export." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="RehydrateButton" Grid.Column="1" Content="Rehydrate a returned file" Click="Rehydrate_Click" Margin="0,0,8,0" IsEnabled="False"/><StackPanel Grid.Column="2"><Button x:Name="DesensitizeButton" Content="Export desensitized copy" Click="Desensitize_Click" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True" IsEnabled="False"/><Button x:Name="ExportGuidanceButton" Content="Help me export" Click="ExportHelp_Click" Margin="0,5,0,0" Padding="8,3" AutomationProperties.Name="Help me export"/></StackPanel></Grid></Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#F7F9FC" BorderBrush="#E5EAF1" BorderThickness="0,1,0,0" Padding="24,0"><Grid><TextBlock x:Name="StatusText" Foreground="#5A6678" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,380,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="FooterMemory" Text="Memory usage unavailable" Foreground="#5A6678" FontSize="11" VerticalAlignment="Center" ToolTip="Approximate memory in use by Desensitizer and its local analysis workers. Shared memory may be counted in more than one process."/><TextBlock Text="  •  " Foreground="#A0AABD" FontSize="11"/><TextBlock x:Name="FooterVersion" Text="Desensitizer" Foreground="#5A6678" FontSize="11" VerticalAlignment="Center"/></StackPanel></Grid></Border>
    </Grid>
</Window>
