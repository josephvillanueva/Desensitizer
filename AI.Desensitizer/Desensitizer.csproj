<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.2.18</Version>
    <AssemblyName>AI.Desensitizer</AssemblyName>
    <Product>AI Desensitizer</Product>
    <ApplicationIcon>Assets\Desensitizer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Formats\*.cs" Link="Shared\Formats\%(Filename)%(Extension)" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <Resource Include="Assets\Desensitizer.ico" />
  </ItemGroup>
</Project>
