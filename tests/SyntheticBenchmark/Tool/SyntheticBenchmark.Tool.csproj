<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-independent tool: generate synthetic documents and score any findings JSON. No app reference. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RootNamespace>SyntheticBenchmark</RootNamespace></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <Compile Include="../Common/*.cs" Link="Common/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
